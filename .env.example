# ─────────────────────────────────────────────
# Datenbank
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ticketdesk"

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
NEXTAUTH_URL="https://deine-domain.de"
# Generieren mit: openssl rand -base64 32
NEXTAUTH_SECRET="HIER_GEHEIMEN_SCHLUESSEL_EINTRAGEN"

# ─────────────────────────────────────────────
# E-Mail (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="support@deine-domain.de"

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://deine-domain.de"
NEXT_PUBLIC_APP_NAME="TicketDesk"
